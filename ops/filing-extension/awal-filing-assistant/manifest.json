{
  "manifest_version": 3,
  "name": "Awal Filing Assistant",
  "short_name": "Awal Filing",
  "version": "1.0.0",
  "description": "Fills agency portals (CAC, SCUML, NRS, NDPC) from an Awal Global Consults case. You check and submit.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Awal Filing Assistant", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": ["https://awalglobal.com.ng/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "116"
}
